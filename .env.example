# ─────────────────────────────────────────────────────────────────────────────
# Chaapo — environment configuration
#
#   cp .env.example .env.local
#
# Every value below is validated by `src/server/config/env.ts` at boot. The app
# refuses to start on invalid config rather than failing later at runtime.
#
# BUSINESS settings (commission %, refund windows, SLA minutes, retention days,
# page/size caps, pricing bands) are NOT here — they live in the `platform_config`
# table so Super Admin can change them without a deploy, and every change is
# audited (FR-1101, A-21). See src/server/core/config-store.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ── Database (PostgreSQL 16 + PostGIS 3.4) ───────────────────────────────────
DATABASE_URL=postgresql://chaapo:chaapo@localhost:5432/chaapo
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Redis (cache, queues, SSE pub/sub, rate limits) ──────────────────────────
REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate real values with:  openssl rand -base64 32
# SESSION_SECRET      signs session + CSRF tokens (HS256)
# ENCRYPTION_KEY      AES-256-GCM data key for PII at rest (PAN, bank, pickup codes)
# PICKUP_TOKEN_SECRET signs the QR pickup token bound to {order_id, shop_id, jti, exp}
SESSION_SECRET=dev-only-session-secret-change-me-0000000000
ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1lbmNyeXB0aW9uLWtleS0xMg==
PICKUP_TOKEN_SECRET=dev-only-pickup-secret-change-me-000000000

# ── Object storage (S3-compatible, PRIVATE buckets only) ─────────────────────
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=chaapo
S3_SECRET_ACCESS_KEY=chaapo-dev-secret
S3_FILES_BUCKET=chaapo-files
S3_ASSETS_BUCKET=chaapo-assets
S3_FORCE_PATH_STYLE=true
# Production: aws:kms with a customer-managed key in ap-south-1 (NFR-12).
S3_SSE=AES256
S3_KMS_KEY_ID=

# ── Payments ─────────────────────────────────────────────────────────────────
# mock      → MockPaymentProvider: a real state machine with HMAC-signed webhooks
#             posted back to /api/v1/webhooks/payments. No credentials needed.
#             Supports forced `fail`, `timeout` and `duplicate` outcomes.
# razorpay  → Razorpay Route (payment aggregator, split settlement, on-hold
#             transfers). Requires the credentials below.
#
# Chaapo NEVER pools customer money in its own account (PRD §38.1). Funds are
# held at the aggregator against the shop's linked sub-merchant account and are
# released only after verified collection.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=dev-only-mock-webhook-secret-0000000000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
# dev  → writes every message to `notification_outbox`, emails go to Mailpit,
#        web push is REAL (VAPID), WhatsApp/SMS render the exact template payload
#        that would be sent live and are viewable at /admin/notifications.
# live → uses the configured WhatsApp / SMS / SMTP credentials.
NOTIFY_TRANSPORT=dev

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Chaapo <no-reply@chaapo.in>"

# WhatsApp Business (utility templates, pre-approved). Empty in dev.
WHATSAPP_PROVIDER=none
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=

# SMS — India requires TRAI DLT registration of the header and every template.
SMS_PROVIDER=none
SMS_SENDER_ID=CHAAPO
SMS_DLT_ENTITY_ID=
SMS_API_KEY=

# Web Push (VAPID). Real in dev. Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:ops@chaapo.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Geocoding / maps ─────────────────────────────────────────────────────────
# local → PostGIS-only: reverse geocoding resolves to the seeded belt/locality
#         polygons; no external calls, no PII leaves the box.
GEO_PROVIDER=local
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ── Malware scanning for uploads ─────────────────────────────────────────────
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Workers ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# Set to `false` to run the app without a worker (queues will back up).
WORKER_ENABLED=true

# ── Development conveniences (must be false outside development) ─────────────
# Returns the OTP in the API response so you can log in without an SMS gateway.
OTP_DEV_ECHO=true
# Disables rate limiting. Only honoured when APP_ENV=development or test.
RATE_LIMIT_DISABLED=false

# ── Client-visible (NEXT_PUBLIC_*) — never put secrets here ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPPORT_PHONE=+911800000000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_MAP_PROVIDER=none
NEXT_PUBLIC_MAP_TOKEN=
